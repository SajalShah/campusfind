# Supabase (from your project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://duzybzrpnabciwvnfpqi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wVo93v2SzRKvlchT0DY9tQ_bh0oULKi

# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never commit the real value.
# From Supabase dashboard -> Project Settings -> API -> service_role key.
# Powers the matching engine (app/api/match) so it can write match_suggestions
# regardless of RLS. Rotate this key if it's ever exposed anywhere (chat, a
# public repo, a screenshot, etc.) — treat it like a master password.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Used directly by lib/email.ts to notify both parties when a match is
# found (app/api/match). Same key you set up for Supabase SMTP earlier —
# reuse it here, no need to create a second Resend account.
RESEND_API_KEY=your_resend_api_key
NOTIFY_FROM_EMAIL=CampusFind <onboarding@resend.dev>
